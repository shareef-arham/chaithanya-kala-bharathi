{
  "rewrites": [
    { "source": "/data/:name", "destination": "/api/content/:name" },
    { "source": "/uploads/:file", "destination": "/api/media/:file" },
    { "source": "/pdf/(.*)", "destination": "/api/media/$1" },
    { "source": "/media/(.*)", "destination": "/api/media/$1" }
  ],
  "functions": {
    "api/content/[name].js": { "includeFiles": "seed/data/**" }
  }
}
